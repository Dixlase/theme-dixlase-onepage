{
    "name": "Dixlase OnePage",
    "package": "DixlaseOnePage",
    "package_name": "dixlase/dixlase-onepage",
    "slug": "dixlase-onepage",
    "version": "0.1.2",
    "description": {
        "ja": "Dixlase OnePage テーマ。プラグイン連動型のシングルページ/LP用テーマ。",
        "en": "Dixlase OnePage theme. Plugin-driven single page / landing page theme."
    },
    "author": "exc-D inc.",
    "email": "info@dixlase.org",
    "url": "https://exc-d.com",
    "license": "GPL-3.0",
    "license_template": "license-dual-gpl.txt",
    "commercial_license": {
        "available": true,
        "file": "LICENSE.commercial",
        "contact": "info@dixlase.org"
    },
    "assets": {
        "common": [],
        "admin": [],
        "front": [
            "front/js/app.js",
            "front/scss/style.scss"
        ]
    },
    "thumbnail": "resources/assets/thumbnail.png",
    "namespace": "Themes\\DixlaseOnePage",
    "providers": [
        "Themes\\DixlaseOnePage\\App\\Providers\\DixlaseOnePageServiceProvider"
    ],
    "type": "dixlase-theme",
    "tags": [
        "onepage",
        "landing",
        "simple",
        "modern",
        "responsive"
    ],
    "requires": {
        "dixlase": ">=1.0.0",
        "dixlase_api": "^0.1",
        "php": ">=8.2"
    },
    "capabilities": [
        "multilingual-content"
    ],
    "multilingual_content": {
        "types": [
            {
                "key": "dixlase-onepage:settings",
                "cardinality": "singleton",
                "provider": "Themes\\DixlaseOnePage\\App\\Multilingual\\DixlaseOnePageSettingsProvider",
                "label_key": "themes::multilingual_types.settings",
                "fields": [
                    {
                        "name": "hero_main_title",
                        "type": "textarea",
                        "rules": "nullable|string|max:200"
                    },
                    {
                        "name": "hero_sub_title",
                        "type": "textarea",
                        "rules": "nullable|string|max:500"
                    },
                    {
                        "name": "hero_button_text",
                        "type": "text",
                        "rules": "nullable|string|max:100"
                    },
                    {
                        "name": "hero_button_secondary_text",
                        "type": "text",
                        "rules": "nullable|string|max:100"
                    }
                ]
            }
        ]
    },
    "supports": {
        "dark_mode": true,
        "responsive": true,
        "front_page_builder": true,
        "custom_colors": true
    },
    "customizable": {
        "colors": {
            "primary": "#3b82f6",
            "secondary": "#6b7280",
            "accent": "#10b981"
        },
        "fonts": {
            "body": "system-ui, -apple-system, sans-serif",
            "heading": "system-ui, -apple-system, sans-serif"
        }
    },
    "permissions": {
        "database": {
            "own_tables": true,
            "core_tables_read": [
                "media"
            ],
            "core_tables_write": []
        },
        "storage": {
            "own_directory": false,
            "public_uploads": false,
            "temp_files": false
        },
        "settings": {
            "read_core": true,
            "write_own": false
        },
        "assets": {
            "custom_css": true,
            "custom_js": true,
            "external_resources": true
        },
        "system": {
            "register_shortcodes": false,
            "register_middleware": false,
            "register_commands": false,
            "register_blade_directives": false,
            "modify_routes": false
        }
    },
    "repository": "Dixlase/theme-dixlase-onepage",
    "csp": {
        "external_domains": {
            "fonts": [
                "https://fonts.bunny.net"
            ],
            "styles": [
                "https://fonts.bunny.net"
            ]
        }
    }
}
