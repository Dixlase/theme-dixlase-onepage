{
    "name": "Dixlase OnePage",
    "package_name": "dixlase/dixlase-one-page",
    "slug": "dixlase-one-page",
    "version": "1.0.0",
    "description": {
        "ja": "Dixlase OnePage テーマ。プラグイン連動型のシングルページ/LP用テーマ。",
        "en": "Dixlase OnePage theme. Plugin-driven single page / landing page theme."
    },
    "author": "exc-D inc.",
    "email": "info@exc-d.com",
    "url": "https://exc-d.com",
    "license": "GPL-3.0",
    "license_template": "license-gpl.txt",
    "namespace": "Themes\\DixlaseOnePage",
    "providers": [
        "Themes\\DixlaseOnePage\\App\\Providers\\DixlaseOnePageServiceProvider"
    ],
    "type": "dixlase-theme",
    "screenshot": "screenshot.png",
    "tags": [
        "onepage",
        "landing",
        "simple",
        "modern",
        "responsive"
    ],
    "requires": {
        "dixlase": ">=1.0.0",
        "php": ">=8.2"
    },
    "assets": {
        "common": ["js/app.js"],
        "admin": [],
        "front": ["front/scss/style.scss"]
    },
    "supports": {
        "dark_mode": true,
        "responsive": true,
        "front_page_builder": true,
        "custom_colors": true
    },
    "customizable": {
        "colors": {
            "primary": "#3b82f6",
            "secondary": "#6b7280",
            "accent": "#10b981"
        },
        "fonts": {
            "body": "system-ui, -apple-system, sans-serif",
            "heading": "system-ui, -apple-system, sans-serif"
        }
    },
    "permissions": {
        "database": {
            "own_tables": true,
            "core_tables_read": ["media"],
            "core_tables_write": []
        },
        "storage": {
            "own_directory": false,
            "public_uploads": false,
            "temp_files": false
        },
        "settings": {
            "read_core": true,
            "write_own": false
        },
        "assets": {
            "custom_css": true,
            "custom_js": true,
            "external_resources": true
        },
        "system": {
            "register_shortcodes": false,
            "register_middleware": false,
            "register_commands": false,
            "register_blade_directives": false,
            "modify_routes": false
        }
    },
    "csp": {
        "external_domains": {
            "fonts": [
                "https://fonts.bunny.net"
            ],
            "styles": [
                "https://fonts.bunny.net"
            ]
        }
    }
}