{
    "name": "Dixlase Default Theme",
    "package_name": "dixlase/dixlase-default-theme",
    "slug": "dixlase-default-theme",
    "version": "1.0.0",
    "description": {
        "ja": "Dixlaseのデフォルトテーマ。シンプルでモダンなデザイン。",
        "en": "Default theme for Dixlase. Simple and modern design."
    },
    "author": "exc-D inc.",
    "email": "info@exc-d.com",
    "url": "https://exc-d.com",
    "license": "GPL-3.0",
    "license_template": "license-gpl.txt",
    "namespace": "Themes\\DixlaseDefaultTheme",
    "type": "dixlase-theme",
    "screenshot": "screenshot.png",
    "tags": [
        "default",
        "simple",
        "modern",
        "responsive"
    ],
    "requires": {
        "dixlase": ">=1.0.0",
        "php": ">=8.2"
    },
    "supports": {
        "dark_mode": true,
        "responsive": true,
        "front_page_builder": true,
        "custom_colors": true
    },
    "customizable": {
        "colors": {
            "primary": "#3b82f6",
            "secondary": "#6b7280",
            "accent": "#10b981"
        },
        "fonts": {
            "body": "system-ui, -apple-system, sans-serif",
            "heading": "system-ui, -apple-system, sans-serif"
        }
    },
    "permissions": {
        "database": {
            "own_tables": true,
            "core_tables": [
                "media:read"
            ]
        },
        "storage": {
            "own_directory": true,
            "public_uploads": false,
            "temp_files": false
        },
        "settings": {
            "read_core": true,
            "write_own": true
        },
        "assets": {
            "custom_css": true,
            "custom_js": true,
            "external_resources": false
        },
        "system": {
            "register_shortcodes": false,
            "register_middleware": false,
            "register_commands": false,
            "register_blade_directives": false,
            "modify_routes": true
        }
    }
}